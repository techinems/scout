# ── Database ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://scout:scout@localhost:5434/scout"

# ── Auth ────────────────────────────────────────────────────────────
# "true" skips Keycloak entirely and signs you in as a synthetic admin.
# NEVER enable in production.
AUTH_DISABLED="false"

# Random string, 32+ chars — encrypts the session cookie.
SESSION_SECRET=""

# Keycloak OIDC (discovery URL is derived from the issuer).
KEYCLOAK_ISSUER=""            # e.g. https://sso.example.org/realms/team
KEYCLOAK_CLIENT_ID="scout"
KEYCLOAK_CLIENT_SECRET=""
# Realm role required to enter the app at all.
KEYCLOAK_REQUIRED_ROLE="scout-access"
# Public base URL of this deployment (OIDC redirect URI is derived from it).
APP_URL="http://localhost:3000"

# Comma-separated emails granted the Administrator role on first login.
ADMIN_EMAILS=""

# ── Google Maps Platform ────────────────────────────────────────────
# Server key: Geocoding API + Routes API + Places API (New) for address
# autocomplete. Restrict by IP.
GOOGLE_MAPS_API_KEY=""
# Browser key: Maps JavaScript API (LZ picker). Restrict by referrer.
# Falls back to GOOGLE_MAPS_API_KEY when unset.
GOOGLE_MAPS_BROWSER_KEY=""

# ── Deployment branding & behavior (all optional) ───────────────────
# Unset values fall back to generic defaults. Read at runtime.
APP_NAME=""                    # default: Scout
APP_ORGANIZATION=""            # default: Tactical EMS Unit
APP_UNIT_LINE=""               # subtitle under the app name; default: TEMS Mission Support
APP_DESCRIPTION=""
APP_AGENCIES=""                # comma-separated, first is the default; default: EMS,Police,Other
APP_TIMEZONE=""                # IANA zone; default: America/New_York
APP_LOGIN_NOTICE=""
APP_FOOTER_NOTICE=""

# LZ map starting view: lat,lng,zoom (default: whole US)
MAP_CENTER=""
# Address autocomplete: countries (comma-separated, default: us), and an
# optional south,west,north,east box to prefer (or with RESTRICT=true,
# require). Without a box, suggestions are biased to a 50 km circle around
# MAP_CENTER when its zoom is 8 or more.
ADDRESS_REGION_CODES=""
ADDRESS_BIAS=""
ADDRESS_BIAS_RESTRICT="false"

# Med plan aeromedical request→landing estimate
AERO_LAUNCH_MINUTES=""         # default: 10
AERO_CRUISE_KNOTS=""           # default: 130
AERO_LANDING_BUFFER_MINUTES="" # default: 3

# ── Web Push (optional) ─────────────────────────────────────────────
# Generate once: npx web-push generate-vapid-keys
# Leave empty to disable push notifications.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.org"

# ── Seed ────────────────────────────────────────────────────────────
# "true" seeds Massachusetts demo facilities (dev only).
SEED_DEMO_DATA="false"
