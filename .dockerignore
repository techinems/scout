# Secrets and local env — must never reach an image. Next.js copies any
# .env file it finds into its standalone output, so these would otherwise
# ship inside the production image.
.env
.env.*
!.env.example
scripts/secrets.env

# Rebuilt inside the image
node_modules
.next
src/generated

# Not needed to build
.git
.claude
*.log
.DS_Store
