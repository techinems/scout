# Copy to scripts/secrets.env (gitignored) and fill in before running
# scripts/deploy.sh.

# Image to publish. The repo must exist or your token must be allowed to
# create packages.
IMAGE="ghcr.io/techinems/scout"

# GHCR auth. Leave GHCR_TOKEN empty to use `gh auth token` — the gh token
# must carry the write:packages scope:
#   gh auth refresh -h github.com -s write:packages,read:packages
GHCR_USER="your-github-username"
GHCR_TOKEN=""

# Coolify instance + the application resource to redeploy.
COOLIFY_URL="https://coolify.example.org"
COOLIFY_API_TOKEN="..."
# Application UUID — visible in the Coolify URL when the app is open.
COOLIFY_RESOURCE_UUID="..."
